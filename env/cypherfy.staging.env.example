# CypherFy staging env — non-secret values only.
# Copy to env/cypherfy.staging.env (gitignored). Compose loads it into cypherfy-backend.
#
# Deliberately absent:
#   MONGODB_URI, REDIS_URL, CLIENT_URL, KAIRO_*  -> set by docker-compose.yml (local services only, never Atlas)
#   ACCESS/REFRESH_TOKEN_SECRET                   -> from the root .env via Compose
#   R2_*, FIREBASE_*, SMTP_*, RESEND_API_KEY      -> unset: uploads, push, Google sign-in and email are off in staging

NODE_ENV=production
PORT=8000

# No proxy in front of the backend on the demo laptop. Must be 0: with 1, req.ip
# would come from X-Forwarded-For and an attack script could fake its source IP.
TRUST_PROXY=0

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CypherFy's own HTTP limiters keep their production defaults (30 free auth
# attempts per IP, 8 per email), so Kairo's R1 (5 / 10 failures) acts first.
RATE_LIMIT_ENABLED=true
