# Kairo Shield — copy to .env (gitignored) and fill in the blanks.
# Generate random values with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Shared ---
KAIRO_ENV=staging                    # local | staging | production (production forces shadow)
KAIRO_HASH_SECRET=                   # 32+ random bytes, base64; same value in CypherFy's env (Compose passes it)
DEMO_HOST=localhost                  # host the browser uses for CypherFy web/API; baked into the web build
CYPHERFY_PATH=../CypherFy           # CypherFy repo (build context), on branch `kairo`; relative to this folder
CYPHERFY_TAG=dev                     # image tag for cypherfy-backend; R4's deployer re-points it at the deployed version

# --- Mongo (local Compose service, never Atlas) ---
# Hex values only: they go into connection URIs unescaped.
MONGO_ROOT_PASSWORD=
CYPHERFY_DB_PASSWORD=
KAIRO_DB_PASSWORD=

# --- CypherFy staging secrets (passed to cypherfy-backend by Compose) ---
CYPHERFY_ACCESS_TOKEN_SECRET=        # 32+ random chars, staging only
CYPHERFY_REFRESH_TOKEN_SECRET=       # 32+ random chars, staging only

# --- Demo data (scripts/seed-cypherfy.js, attacks/legit-check.js) ---
DEMO_PASSWORD=                       # password for demo01..demo20@kairo.test (staging only, min 8 chars)
DEMO_ROOM_CODE=                      # 6 chars from ABCDEFGHJKMNPQRSTUVWXYZ23456789; never logged

# --- Defender ---
KAIRO_PORT=7070
KAIRO_REDIS_URL=redis://redis:6379
KAIRO_MONGO_URI=mongodb://kairo_defender:${KAIRO_DB_PASSWORD}@mongo:27017/kairo
KAIRO_RULES_PATH=/app/config/rules.json
KAIRO_STALE_EVENT_MS=300000
CYPHERFY_HEALTH_URL=http://cypherfy-backend:8000/api/v1/health
LOG_LEVEL=info

# --- GitHub poller (Pipeline screen) ---
GITHUB_REPO=PunitXd/CypherFy
GITHUB_TOKEN=                        # fine-grained PAT: only this repo, Actions: read-only, 30-day expiry. Optional: without it the Pipeline screen shows pass/fail but no findings
GITHUB_POLL_MS=15000

# --- Hooks (set in CypherFy's env by Compose, listed here for reference) ---
# KAIRO_ENABLED=true
# KAIRO_REDIS_URL=redis://redis:6379
# KAIRO_REDIS_TIMEOUT_MS=50
# KAIRO_FLOOR_AUTH_PER_MIN=100       # in-process floor limiter used when Redis is down

# Not in the Demo MVP (PHASES §1): KAIRO_ADMIN_PASSWORD_HASH (console login).

# R4 auto-rollback: shared by scripts/deploy.sh, scripts/deployer.js and the
# Defender. Generate with: openssl rand -hex 32
KAIRO_DEPLOY_TOKEN=
