{
  "name": "kairo-shield",
  "private": true,
  "version": "0.1.0",
  "description": "Self-healing DevSecOps for encrypted systems. Protects a staging copy of CypherFy.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend/*",
    "attacks",
    "frontend"
  ],
  "scripts": {
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "seed": "node --env-file=.env scripts/seedCypherfy.js",
    "demo:reset": "node --env-file=.env scripts/demoReset.js",
    "hooks:sync": "bash scripts/syncHooks.sh",
    "tail": "node scripts/tailEvents.js",
    "test": "npm test --workspaces --if-present && node --test \"scripts/*.test.js\"",
    "dashboard:dev": "npm run dev -w frontend",
    "dashboard:build": "npm run build -w frontend"
  },
  "devDependencies": {
    "kairo-schema": "*",
    "ioredis": "5.11.1"
  }
}
