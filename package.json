{
  "name": "kairo-shield",
  "private": true,
  "version": "0.1.0",
  "description": "Self-healing DevSecOps for encrypted systems. Protects a staging copy of CypherFy.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend/*",
    "attacks"
  ],
  "scripts": {
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "seed": "node --env-file=.env scripts/seed-cypherfy.js",
    "sync-hooks": "bash scripts/sync-hooks.sh",
    "tail": "node scripts/tail-events.js",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@kairo/schema": "*",
    "ioredis": "5.11.1"
  }
}
