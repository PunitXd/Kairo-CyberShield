{
  "name": "kairo-shield",
  "private": true,
  "version": "0.1.0",
  "description": "Self-healing DevSecOps for encrypted systems. Protects a staging copy of CypherFy.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend/*",
    "attacks"
  ],
  "scripts": {
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "seed": "node --env-file=.env scripts/seedCypherfy.js",
    "hooks:sync": "bash scripts/syncHooks.sh",
    "tail": "node scripts/tailEvents.js",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "kairo-schema": "*",
    "ioredis": "5.11.1"
  }
}
